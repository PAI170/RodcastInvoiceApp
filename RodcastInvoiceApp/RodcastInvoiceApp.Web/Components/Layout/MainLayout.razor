@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using RodcastInvoiceApp.Web.Resources
@inject IStringLocalizer<SharedResource> Loc

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger mt-3">
                        <p>
                            <strong>@Loc["Layout_ErrorTitle"]</strong> @Loc["Layout_ErrorBody"]
                        </p>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => errorBoundary?.Recover()">
                            @Loc["Layout_Retry"]
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" href=".">@Loc["Layout_ReloadPage"]</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;
}
