@using RodcastInvoiceApp.Web.DataTransferObjects.Invoice

@if (IsVisible)
{
    <div class="email-modal-backdrop" @onclick="Close">
        <div class="email-modal-content" @onclick:stopPropagation="true">
            <div class="email-modal-header">
                <strong>Enviar factura por correo</strong>
                <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Close"></button>
            </div>
            <div class="p-3">
                @if (Preview is null)
                {
                    <p><em>Cargando...</em></p>
                }
                else
                {
                    @if (!Preview.SenderConfigured)
                    {
                        <div class="alert alert-warning">
                            Todavía no configuraste tu correo. Andá a <a href="/mi-correo">Mi correo</a> primero.
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(Preview.ToEmail))
                    {
                        <div class="alert alert-warning">
                            Este cliente no tiene un email cargado. Agregalo en la ficha del cliente primero.
                        </div>
                    }
                    <dl class="row mb-0">
                        <dt class="col-sm-2">Para</dt>
                        <dd class="col-sm-10">@(Preview.ToEmail ?? "(sin email)")</dd>
                        <dt class="col-sm-2">Asunto</dt>
                        <dd class="col-sm-10">@Preview.Subject</dd>
                        <dt class="col-sm-2">Mensaje</dt>
                        <dd class="col-sm-10" style="white-space: pre-wrap;">@Preview.Body</dd>
                        <dt class="col-sm-2">Adjuntos</dt>
                        <dd class="col-sm-10">Factura (PDF)@(Preview.IncludesTimesheet ? ", Timesheet (PDF)" : "")</dd>
                    </dl>
                }
            </div>
            <div class="p-3 border-top d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" disabled="@(!CanSend || IsSending)" @onclick="Confirm">
                    @(IsSending ? "Enviando..." : "Enviar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public InvoiceEmailPreviewDto? Preview { get; set; }

    [Parameter]
    public bool IsSending { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    private bool CanSend => Preview is { SenderConfigured: true } && !string.IsNullOrWhiteSpace(Preview.ToEmail);

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task Confirm() => await OnConfirm.InvokeAsync();
}
