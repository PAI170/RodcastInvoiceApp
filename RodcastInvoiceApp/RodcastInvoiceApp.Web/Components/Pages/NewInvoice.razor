@page "/invoices/new"
@page "/invoices/{InvoiceId:int}/edit"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using RodcastInvoiceApp.Web.Data.Models
@using RodcastInvoiceApp.Web.DataTransferObjects.BankAccount
@using RodcastInvoiceApp.Web.DataTransferObjects.Invoice
@using RodcastInvoiceApp.Web.DataTransferObjects.PriceRule
@using RodcastInvoiceApp.Web.DataTransferObjects.Project
@using RodcastInvoiceApp.Web.Exceptions
@using RodcastInvoiceApp.Web.Interfaces
@using RodcastInvoiceApp.Web.Resources
@inject IInvoiceService InvoiceService
@inject IProjectService ProjectService
@inject IBankAccountService BankAccountService
@inject IPriceRuleService PriceRuleService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@(InvoiceId.HasValue ? Loc["NewInvoice_EditTitle"] : Loc["NewInvoice_NewTitle"])</PageTitle>

<h1>@(InvoiceId.HasValue ? Loc["NewInvoice_EditTitle"] : Loc["NewInvoice_NewTitle"])</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (createdInvoice is not null)
{
    <div class="alert alert-success">
        <p>@Loc["NewInvoice_Created", createdInvoice.InvoiceNumber, createdInvoice.ClientName, createdInvoice.ProjectName]</p>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc["Field_Description"]</th>
                    <th>@Loc["Field_Quantity"]</th>
                    <th>@Loc["Field_Unit"]</th>
                    <th>@Loc["Field_Rate"]</th>
                    <th>@Loc["Field_Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in createdInvoice.Items)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>@item.Unit</td>
                        <td>@item.Rate.ToString("0.00")</td>
                        <td>@item.Amount.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <p>
            @Loc["InvoiceDetail_Subtotal"]: @createdInvoice.Subtotal.ToString("0.00") @createdInvoice.Currency<br />
            @Loc["InvoiceDetail_Vat"] (@createdInvoice.VatPercent%): @createdInvoice.VatAmount.ToString("0.00") @createdInvoice.Currency<br />
            <strong>@Loc["Field_Total"]: @createdInvoice.Total.ToString("0.00") @createdInvoice.Currency</strong>
        </p>
        <a class="btn btn-outline-primary btn-sm" href="/invoices">@Loc["NewInvoice_ViewAllInvoices"]</a>
    </div>
}

@if (projects is null || bankAccounts is null || isLoadingInvoice)
{
    <p><em>@Loc["Common_Loading"]</em></p>
}
else if (InvoiceId.HasValue && !canEditInvoice)
{
    <div class="alert alert-danger">@Loc["NewInvoice_NoPermission"]</div>
    <a class="btn btn-outline-secondary" href="/invoices">@Loc["NewInvoice_BackToInvoices"]</a>
}
else
{
    @if (InvoiceId.HasValue)
    {
        <p class="text-muted">
            @Loc["NewInvoice_CannotChangeProject"]
        </p>
    }

    <EditForm Model="dto" FormName="InvoiceForm" OnValidSubmit="HandleSubmit">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">@Loc["Field_Project"]</label>
                <InputSelect class="form-select" @bind-Value="dto.ProjectId" @bind-Value:after="OnProjectChanged" disabled="@InvoiceId.HasValue">
                    <option value="0">@Loc["NewInvoice_SelectProject"]</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.ClientName - @project.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">@Loc["InvoiceDetail_BankAccount"]</label>
                <InputSelect class="form-select" @bind-Value="dto.BankAccountId">
                    <option value="0">@Loc["NewInvoice_SelectAccount"]</option>
                    @foreach (var account in bankAccounts)
                    {
                        <option value="@account.Id">@account.BankName (@account.Currency)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">@Loc["Invoices_InvoiceNumberFull"]</label>
                <InputText class="form-control" @bind-Value="dto.InvoiceNumber" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Loc["Field_Date"]</label>
                <InputDate class="form-control" @bind-Value="dto.InvoiceDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Loc["Field_DueDate"]</label>
                <InputDate class="form-control" @bind-Value="dto.DueDate" />
            </div>
        </div>

        <div class="row g-2 mt-1">
            <div class="col-md-2">
                <label class="form-label">@Loc["Field_Currency"]</label>
                <InputText class="form-control" @bind-Value="dto.Currency" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Loc["Field_VatPercent"]</label>
                <InputNumber class="form-control" step="0.01" @bind-Value="dto.VatPercent" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="dto.IsVatExonerated" />
                    <label class="form-check-label">@Loc["NewInvoice_VatExonerated"]</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">@Loc["NewInvoice_PaymentMethodOptional"]</label>
                <InputText class="form-control" @bind-Value="dto.PaymentMethod" />
            </div>
        </div>

        @if (selectedProject is not null && selectedProject.BillingType == BillingType.MonthlyRetainer)
        {
            <h3 class="mt-4">@Loc["NewInvoice_MonthlyRetainerTitle"]</h3>
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label">@Loc["NewInvoice_VacationDays"]</label>
                    <InputNumber class="form-control" @bind-Value="dto.VacationDays" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Loc["NewInvoice_WorkedDays"]</label>
                    <InputNumber class="form-control" @bind-Value="dto.WorkedDays" disabled="@(dto.VacationDays == 0)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Loc["NewInvoice_OvertimeHoursPrevMonth"]</label>
                    <InputNumber class="form-control" step="0.01" @bind-Value="dto.OvertimeHoursToInvoice" />
                </div>
            </div>
            <p class="text-muted mt-1">
                @Loc["NewInvoice_MonthlyRetainerHelp"]
            </p>
        }

        @if (selectedProject is not null && selectedProject.BillingType == BillingType.PerTicket)
        {
            <h3 class="mt-4">@Loc["NewInvoice_TicketTitle"]</h3>
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label">@Loc["NewInvoice_TicketNumber"]</label>
                    <InputText class="form-control" @bind-Value="dto.TicketNumber" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Loc["Field_City"]</label>
                    <InputSelect class="form-select" @bind-Value="dto.City">
                        <option value="">@Loc["NewInvoice_Select"]</option>
                        @foreach (var city in AvailableCities)
                        {
                            <option value="@city">@city</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Loc["NewInvoice_SlaType"]</label>
                    <InputSelect class="form-select" @bind-Value="dto.SlaType">
                        <option value="">@Loc["NewInvoice_Select"]</option>
                        @foreach (var sla in AvailableSlaTypes)
                        {
                            <option value="@sla">@sla</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Loc["NewInvoice_EventDuration"]</label>
                    <InputNumber class="form-control" step="0.25" @bind-Value="ticketDurationHours" @bind-Value:after="OnDurationChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Loc["NewInvoice_OvertimeHours"]</label>
                    <InputNumber class="form-control" step="0.01" @bind-Value="dto.OvertimeHoursToInvoice" />
                </div>
            </div>
            <p class="text-muted mt-1">
                @Loc["NewInvoice_TicketHelp", AdditionalMinutesPreview]
            </p>
        }

        <button type="submit" class="btn btn-primary mt-3" disabled="@(dto.ProjectId == 0 || isSubmitting)">
            @(InvoiceId.HasValue ? Loc["NewInvoice_SaveChanges"] : Loc["NewInvoice_CreateInvoice"])
        </button>
        <a class="btn btn-outline-secondary mt-3" href="@CancelUrl">@Loc["Common_Cancel"]</a>
    </EditForm>
}

@code {
    [Parameter]
    public int? InvoiceId { get; set; }

    private List<ProjectResponseDto>? projects;
    private List<BankAccountResponseDto>? bankAccounts;
    private ProjectResponseDto? selectedProject;
    private List<PriceRuleResponseDto> priceRulesForProject = new();
    private InvoiceCreateDto dto = new();
    private InvoiceResponseDto? createdInvoice;
    private string? errorMessage;
    private bool isLoadingInvoice;
    private bool isSubmitting;
    private bool canEditInvoice = true;
    private decimal ticketDurationHours = 1m;

    private int AdditionalMinutesPreview => dto.ApprovedAdditionalMinutes;

    private void OnDurationChanged()
    {
        var extraMinutes = (ticketDurationHours - 1m) * 60m;
        dto.ApprovedAdditionalMinutes = extraMinutes > 0 ? (int)Math.Round(extraMinutes, MidpointRounding.AwayFromZero) : 0;
    }

    private string CancelUrl => InvoiceId.HasValue ? $"/invoices/{InvoiceId.Value}" : "/invoices";

    private IEnumerable<string> AvailableCities =>
        priceRulesForProject.Select(pr => pr.Dimension1).Distinct();

    private IEnumerable<string> AvailableSlaTypes =>
        priceRulesForProject
            .Where(pr => pr.Dimension1 == dto.City)
            .Select(pr => pr.Dimension2 ?? string.Empty)
            .Distinct();

    protected override async Task OnInitializedAsync()
    {
        projects = (await ProjectService.GetAllAsync()).ToList();
        bankAccounts = (await BankAccountService.GetAllAsync()).ToList();

        if (InvoiceId.HasValue)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            canEditInvoice = authState.User.IsInRole("Admin");
            if (!canEditInvoice)
                return;

            isLoadingInvoice = true;
            var invoice = await InvoiceService.GetByIdAsync(InvoiceId.Value);
            selectedProject = projects.FirstOrDefault(p => p.Id == invoice.ProjectId);

            dto = new InvoiceCreateDto
            {
                ProjectId = invoice.ProjectId,
                BankAccountId = invoice.BankAccountId,
                InvoiceNumber = invoice.InvoiceNumber,
                InvoiceDate = invoice.InvoiceDate,
                DueDate = invoice.DueDate,
                Currency = invoice.Currency,
                VatPercent = invoice.VatPercent,
                IsVatExonerated = invoice.IsVatExonerated,
                PaymentMethod = invoice.PaymentMethod,
                VacationDays = invoice.VacationDays,
                WorkedDays = invoice.WorkedDays,
                OvertimeHoursToInvoice = invoice.OvertimeHoursToInvoice,
                TicketNumber = invoice.TicketNumber,
                City = invoice.City,
                SlaType = invoice.SlaType,
                ApprovedAdditionalMinutes = invoice.AdditionalMinutes ?? 0
            };

            ticketDurationHours = 1m + (invoice.AdditionalMinutes ?? 0) / 60m;

            if (selectedProject is not null && selectedProject.BillingType == BillingType.PerTicket)
            {
                priceRulesForProject = (await PriceRuleService.GetAllAsync(invoice.ProjectId)).ToList();
            }

            isLoadingInvoice = false;
        }
    }

    private async Task OnProjectChanged()
    {
        selectedProject = projects!.FirstOrDefault(p => p.Id == dto.ProjectId);
        priceRulesForProject.Clear();
        dto.City = null;
        dto.SlaType = null;
        dto.ApprovedAdditionalMinutes = 0;
        ticketDurationHours = 1m;

        if (selectedProject is not null && selectedProject.BillingType == BillingType.PerTicket)
        {
            priceRulesForProject = (await PriceRuleService.GetAllAsync(dto.ProjectId)).ToList();
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;
        try
        {
            if (InvoiceId.HasValue)
            {
                await InvoiceService.UpdateAsync(InvoiceId.Value, dto);
                NavigationManager.NavigateTo($"/invoices/{InvoiceId.Value}");
            }
            else
            {
                createdInvoice = await InvoiceService.CreateAsync(dto);

                // Limpia el formulario: evita que datos de la factura ya creada
                // queden listos para reenviarse por accidente.
                dto = new InvoiceCreateDto();
                selectedProject = null;
                priceRulesForProject.Clear();
                ticketDurationHours = 1m;
            }
        }
        catch (Exception ex) when (ex is BadRequestException or ConflictException or NotFoundException or ForbiddenException)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = Loc["Common_GenericError"];
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
