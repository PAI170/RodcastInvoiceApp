@page "/ajustes"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using RodcastInvoiceApp.Web.Data.Models
@using RodcastInvoiceApp.Web.Resources
@using RodcastInvoiceApp.Web.Security
@inject UserManager<ApplicationUser> UserManager
@inject ISmtpCredentialsProtector CredentialsProtector
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Settings_Title"]</PageTitle>

<h1>@Loc["Settings_Title"]</h1>
<p class="text-muted mb-4">
    @Loc["Settings_Description"]
</p>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (successMessage is not null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (model is null)
{
    <p><em>@Loc["Common_Loading"]</em></p>
}
else
{
    <EditForm Model="model" FormName="SettingsForm" OnValidSubmit="HandleSave">
        <h2 class="h5">@Loc["Settings_SmtpSection"]</h2>
        <div class="row g-3" style="max-width: 600px;">
            <div class="col-md-8">
                <label class="form-label">@Loc["Settings_Host"]</label>
                <InputText class="form-control" placeholder="mail.tudominio.com" @bind-Value="model.Host" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Loc["Settings_Port"]</label>
                <InputNumber class="form-control" @bind-Value="model.Port" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Loc["Settings_ImapPort"]</label>
                <InputNumber class="form-control" @bind-Value="model.ImapPort" />
                <div class="form-text">@Loc["Settings_ImapPortHelp"]</div>
            </div>
            <div class="col-md-8">
                <label class="form-label">@Loc["Settings_YourEmail"]</label>
                <InputText class="form-control" type="email" placeholder="tu@tudominio.com" @bind-Value="model.Username" />
            </div>
            <div class="col-md-8">
                <label class="form-label">@Loc["Settings_Password"]</label>
                <InputText class="form-control" type="password" placeholder="@passwordPlaceholder" @bind-Value="model.Password" />
                <div class="form-text">@Loc["Settings_PasswordHelp"]</div>
            </div>
        </div>

        <hr class="my-4" style="max-width: 600px;" />

        <h2 class="h5">@Loc["Settings_SignatureSection"]</h2>
        <div class="row g-3" style="max-width: 600px;">
            <div class="col-12">
                <label class="form-label">@Loc["Settings_SignatureLabel"]</label>
                <InputTextArea class="form-control" rows="8" style="font-family: monospace; font-size: 0.85rem;"
                                @bind-Value="model.SignatureHtml" />
                <div class="form-text">
                    @Loc["Settings_SignatureHelp"]
                </div>
            </div>
        </div>

        <hr class="my-4" style="max-width: 600px;" />

        <button type="submit" class="btn btn-primary">@Loc["Common_Save"]</button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ApplicationUser? currentUser;
    private SettingsModel? model;
    private string passwordPlaceholder = "••••••••";
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
            return;

        var authState = await AuthStateTask;
        currentUser = await UserManager.GetUserAsync(authState.User);
        if (currentUser is null)
            return;

        model = new SettingsModel
        {
            Host = currentUser.SmtpHost ?? string.Empty,
            Port = currentUser.SmtpPort ?? 465,
            ImapPort = currentUser.ImapPort ?? 993,
            Username = currentUser.SmtpUsername ?? currentUser.Email ?? string.Empty,
            SignatureHtml = currentUser.EmailSignatureHtml ?? string.Empty
        };

        passwordPlaceholder = string.IsNullOrEmpty(currentUser.SmtpPasswordProtected)
            ? Loc["Settings_NotConfiguredPlaceholder"]
            : "••••••••";
    }

    private async Task HandleSave()
    {
        errorMessage = null;
        successMessage = null;

        if (currentUser is null || model is null)
            return;

        try
        {
            currentUser.SmtpHost = model.Host;
            currentUser.SmtpPort = model.Port;
            currentUser.ImapPort = model.ImapPort;
            currentUser.SmtpUsername = model.Username;
            currentUser.EmailSignatureHtml = string.IsNullOrWhiteSpace(model.SignatureHtml) ? null : model.SignatureHtml;

            if (!string.IsNullOrWhiteSpace(model.Password))
                currentUser.SmtpPasswordProtected = CredentialsProtector.Protect(model.Password);

            var result = await UserManager.UpdateAsync(currentUser);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            model.Password = string.Empty;
            passwordPlaceholder = "••••••••";
            successMessage = Loc["Settings_Saved"];
        }
        catch (Exception)
        {
            errorMessage = Loc["Common_GenericError"];
        }
    }

    private class SettingsModel
    {
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 465;
        public int ImapPort { get; set; } = 993;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string SignatureHtml { get; set; } = string.Empty;
    }
}
