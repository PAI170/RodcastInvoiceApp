@page "/"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using RodcastInvoiceApp.Web.Data.Models
@using RodcastInvoiceApp.Web.DataTransferObjects.Client
@using RodcastInvoiceApp.Web.DataTransferObjects.Invoice
@using RodcastInvoiceApp.Web.Interfaces
@using RodcastInvoiceApp.Web.Resources
@inject IClientService ClientService
@inject IInvoiceService InvoiceService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Home_Title"]</PageTitle>

<h1 class="mb-5">@Loc["Home_Title"]</h1>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Loc["Nav_Clients"]</h2>
        <a class="btn btn-outline-primary btn-sm" href="/clients">@Loc["Home_ViewAll"]</a>
    </div>

    @if (recentClients is null)
    {
        <p><em>@Loc["Common_Loading"]</em></p>
    }
    else if (recentClients.Count == 0)
    {
        <p class="text-muted">@Loc["Home_NoClientsYet"]</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc["Field_Name"]</th>
                    <th>@Loc["Field_Country"]</th>
                    <th>@Loc["Field_Projects"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in recentClients)
                {
                    <tr>
                        <td>@client.Name</td>
                        <td>@client.Country</td>
                        <td>@client.ProjectCount</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

<div>
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Loc["Home_RecentInvoices"]</h2>
        <a class="btn btn-outline-primary btn-sm" href="/invoices">@Loc["Home_ViewAll"]</a>
    </div>

    @if (recentInvoices is null)
    {
        <p><em>@Loc["Common_Loading"]</em></p>
    }
    else if (recentInvoices.Count == 0)
    {
        <p class="text-muted">@Loc["Home_NoInvoicesYet"]</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc["Field_InvoiceNo"]</th>
                    <th>@Loc["Field_ClientProject"]</th>
                    <th>@Loc["Field_Date"]</th>
                    <th>@Loc["Field_Status"]</th>
                    <th>@Loc["Field_Total"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in recentInvoices)
                {
                    <tr>
                        <td>@invoice.InvoiceNumber</td>
                        <td>@invoice.ClientName / @invoice.ProjectName</td>
                        <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@invoice.Status.ToDisplayText(Loc)</td>
                        <td>@invoice.Total.ToString("0.00") @invoice.Currency</td>
                        <td><a class="btn btn-outline-secondary btn-sm" href="@($"/invoices/{invoice.Id}")">@Loc["Common_View"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private const int MaxItemsToShow = 10;

    private List<ClientResponseDto>? recentClients;
    private List<InvoiceResponseDto>? recentInvoices;

    protected override async Task OnInitializedAsync()
    {
        recentClients = (await ClientService.GetAllAsync(take: 5)).ToList();
        recentInvoices = (await InvoiceService.GetAllAsync(take: MaxItemsToShow)).ToList();
    }
}
