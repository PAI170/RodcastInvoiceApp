@page "/clients"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using RodcastInvoiceApp.Web.DataTransferObjects.Client
@using RodcastInvoiceApp.Web.Exceptions
@using RodcastInvoiceApp.Web.Interfaces
@using RodcastInvoiceApp.Web.Resources
@inject IClientService ClientService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Clients_Title"]</PageTitle>

<h1>@Loc["Clients_Title"]</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (clients is null)
{
    <p><em>@Loc["Common_Loading"]</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@Loc["Field_Name"]</th>
                <th>@Loc["Field_Address"]</th>
                <th>@Loc["Field_Email"]</th>
                <th>@Loc["Field_VatId"]</th>
                <th>@Loc["Field_Country"]</th>
                <th>@Loc["Field_Currency"]</th>
                <th>@Loc["Field_SupplierId"]</th>
                <th>@Loc["Field_Projects"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                if (editingId == client.Id && editingDto is not null)
                {
                    <tr>
                        <td><input class="form-control" @bind="editingDto.Name" /></td>
                        <td><input class="form-control" @bind="editingDto.Address" /></td>
                        <td><input class="form-control" type="email" @bind="editingDto.Email" /></td>
                        <td><input class="form-control" @bind="editingDto.VatId" /></td>
                        <td><input class="form-control" @bind="editingDto.Country" /></td>
                        <td><input class="form-control" @bind="editingDto.DefaultCurrency" /></td>
                        <td><input class="form-control" @bind="editingDto.SupplierIdAssigned" /></td>
                        <td>@client.ProjectCount</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="HandleUpdate">@Loc["Common_Save"]</button>
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">@Loc["Common_Cancel"]</button>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>@client.Name</td>
                        <td>@client.Address</td>
                        <td>@client.Email</td>
                        <td>@client.VatId</td>
                        <td>@client.Country</td>
                        <td>@client.DefaultCurrency</td>
                        <td>@client.SupplierIdAssigned</td>
                        <td>@client.ProjectCount</td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(client)">@Loc["Common_Edit"]</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => HandleDelete(client.Id)">@Loc["Common_Delete"]</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
}

<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
        <h2>@Loc["Clients_New"]</h2>

        <EditForm Model="newClient" FormName="NewClientForm" OnValidSubmit="HandleCreate">
            <div class="row g-2">
                <div class="col-md-3">
                    <InputText class="form-control" placeholder="@Loc["Field_Name"]" @bind-Value="newClient.Name" />
                </div>
                <div class="col-md-3">
                    <InputText class="form-control" placeholder="@Loc["Field_Address"]" @bind-Value="newClient.Address" />
                </div>
                <div class="col-md-3">
                    <InputText class="form-control" type="email" placeholder="@Loc["Clients_EmailOptionalPlaceholder"]" @bind-Value="newClient.Email" />
                </div>
                <div class="col-md-2">
                    <InputText class="form-control" placeholder="@Loc["Field_VatId"]" @bind-Value="newClient.VatId" />
                </div>
                <div class="col-md-2">
                    <InputText class="form-control" placeholder="@Loc["Field_Country"]" @bind-Value="newClient.Country" />
                </div>
                <div class="col-md-2">
                    <InputText class="form-control" placeholder="@Loc["Field_Currency"]" @bind-Value="newClient.DefaultCurrency" />
                </div>
                <div class="col-md-3">
                    <InputText class="form-control" placeholder="@Loc["Clients_SupplierIdOptionalPlaceholder"]" @bind-Value="newClient.SupplierIdAssigned" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-2">@Loc["Clients_CreateButton"]</button>
        </EditForm>
    </Authorized>
</AuthorizeView>

@code {
    private List<ClientResponseDto>? clients;
    private ClientCreateDto newClient = new();
    private int? editingId;
    private ClientUpdateDto? editingDto;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        clients = (await ClientService.GetAllAsync()).ToList();
    }

    private async Task HandleCreate()
    {
        errorMessage = null;
        try
        {
            await ClientService.CreateAsync(newClient);
            newClient = new ClientCreateDto();
            await LoadClientsAsync();
        }
        catch (Exception ex) when (ex is BadRequestException or ConflictException or ForbiddenException)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = Loc["Common_GenericError"];
        }
    }

    private void StartEdit(ClientResponseDto client)
    {
        editingId = client.Id;
        editingDto = new ClientUpdateDto
        {
            Name = client.Name,
            Address = client.Address,
            Email = client.Email,
            Country = client.Country,
            VatId = client.VatId,
            SupplierIdAssigned = client.SupplierIdAssigned,
            DefaultCurrency = client.DefaultCurrency
        };
    }

    private void CancelEdit()
    {
        editingId = null;
        editingDto = null;
    }

    private async Task HandleUpdate()
    {
        if (editingId is null || editingDto is null) return;

        errorMessage = null;
        try
        {
            await ClientService.UpdateAsync(editingId.Value, editingDto);
            CancelEdit();
            await LoadClientsAsync();
        }
        catch (Exception ex) when (ex is BadRequestException or ConflictException or NotFoundException or ForbiddenException)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = Loc["Common_GenericError"];
        }
    }

    private async Task HandleDelete(int id)
    {
        errorMessage = null;
        try
        {
            await ClientService.DeleteAsync(id);
            await LoadClientsAsync();
        }
        catch (Exception ex) when (ex is ConflictException or NotFoundException or ForbiddenException)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = Loc["Common_GenericError"];
        }
    }
}
